{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=22735 BASE_PATH=/ pnpm --filter @workspace/linkedin-jobs-search run build",
  "outputDirectory": "artifacts/linkedin-jobs-search/dist/public",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
