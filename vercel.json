{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=22735 BASE_PATH=/ pnpm --filter @workspace/linkedin-jobs-search run build && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": "artifacts/linkedin-jobs-search/dist/public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
